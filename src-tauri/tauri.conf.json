{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocialHQ",
  "version": "0.1.0",
  "identifier": "pl.socialhq.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SocialHQ",
        "width": 1320,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Lokalne centrum dowodzenia social media",
    "longDescription": "SocialHQ to offline'owy notatnik i planer do prowadzenia mediów społecznościowych: briefy, pomysły na posty, grupy, biblioteka zdjęć i promptów. Wszystkie dane pozostają lokalnie.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
